{
  "name": "the-endless-house",
  "version": "0.1.0",
  "private": true,
  "description": "An experimental procedural 3D environment: one House, many doors.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "perf": "node scripts/perf.mjs",
    "server": "tsx server/main.ts",
    "smoke:remote": "node scripts/smoke-remote.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SadikMohamud/the-endless-house.git"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
